<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="600" fill="#e7e5e4"/>
  <text x="400" y="250" font-family="serif" font-size="48" fill="#78716c" text-anchor="middle">Before</text>
  <text x="400" y="320" font-family="sans-serif" font-size="18" fill="#a8a29e" text-anchor="middle">Original photo with uneven lighting</text>
  <text x="400" y="350" font-family="sans-serif" font-size="18" fill="#a8a29e" text-anchor="middle">and color distortion</text>
  <rect x="200" y="400" width="400" height="8" rx="4" fill="#d6d3d1"/>
  <rect x="250" y="420" width="300" height="8" rx="4" fill="#d6d3d1"/>
</svg>
